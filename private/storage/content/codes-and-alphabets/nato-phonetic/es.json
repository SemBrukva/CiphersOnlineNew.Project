  "faq": [
    {
      "id": 637,
      "sort_order": 10,
      "published": true,
      "data": {
        "question": "¿Alfa o Alpha, Juliett o Juliet?",
        "answer": "Las formas oficiales son Alfa y Juliett; el servicio también acepta Alpha y Juliet al descifrar."
      }
    },
    {
      "id": 638,
      "sort_order": 20,
      "published": true,
      "data": {
        "question": "¿Por qué los pilotos dicen Niner, Fife y Tree?",
        "answer": "La variante de aviación usa esas formas para evitar confusiones entre cifras."
      }
    },
    {
      "id": 639,
      "sort_order": 30,
      "published": true,
      "data": {
        "question": "¿Puedo escuchar la pronunciación?",
        "answer": "Sí. El navegador lee las palabras con síntesis de voz integrada y permite ajustar la velocidad."
      }
    },
    {
      "id": 640,
      "sort_order": 40,
      "published": true,
      "data": {
        "question": "¿Son iguales los alfabetos NATO e ICAO?",
        "answer": "Sí. El estándar se llama International Radiotelephony Spelling Alphabet."
      }
    },
    {
      "id": 641,
      "sort_order": 50,
      "published": true,
      "data": {
        "question": "¿Cómo formato las palabras clave?",
        "answer": "Elija espacios, guiones, comas o saltos de línea; también puede mostrar A = Alfa."
      }
    },
    {
      "id": 642,
      "sort_order": 60,
      "published": true,
      "data": {
        "question": "¿Qué ocurre con caracteres no admitidos?",
        "answer": "El codificador los omite; una palabra desconocida al descifrar aparece como ?."
      }
    }
  ],
