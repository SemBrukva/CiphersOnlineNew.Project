    "data": {
      "name": "Alphabet phonétique de l’OTAN",
      "name_short": "Alphabet OTAN",
      "description": "Traducteur de l’alphabet phonétique de l’OTAN : convertissez du texte latin et des chiffres en Alfa, Bravo, Charlie, ou décodez les mots codés. Variantes NATO/ICAO, aviation, LAPD et DIN 5009, prononciation et tableau A–Z.",
      "description_stort": "Traducteur de l’alphabet phonétique de l’OTAN : convertissez du texte latin et des chiffres en Alfa, Bravo, Charlie, ou décodez les mots codés. Variantes NATO/ICAO, aviation, LAPD et DIN 5009, prononciation et tableau A–Z.",
      "meta_title": "Alphabet phonétique de l’OTAN : traducteur et tableau | Ciphers Online",
      "meta_description": "Convertissez du texte vers l’alphabet NATO/ICAO ou décodez les mots codés. Alfa Bravo Charlie, aviation, LAPD, DIN 5009, prononciation et tableau."
    }
